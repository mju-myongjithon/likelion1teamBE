# Postgres container (docker-compose.yml) + Spring datasource (application.yaml)
# Both reference these same variables — do not duplicate them elsewhere.
POSTGRES_PORT=5432
POSTGRES_DB=${TEAM_DB}
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# Gmail SMTP (application.yaml spring.mail) — 이메일 인증번호 발송용
# 구글 계정에서 2단계 인증을 켠 뒤 "앱 비밀번호"를 발급받아 사용하세요. (일반 로그인 비밀번호 아님)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=app-password